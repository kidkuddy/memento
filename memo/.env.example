# Copy to .env and adjust.

# Where the git-backed store lives (default: ./store next to memo.py)
MEMO_DIR=./store

# Remote to push to. A real GitHub repo (git@github.com:you/memo.git),
# or a local bare repo for testing (file:///abs/path/to/remote.git).
# Leave empty to work fully local (commit only, no push).
MEMO_REMOTE=
